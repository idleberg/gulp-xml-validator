{
	"name": "gulp-xml-validator",
	"version": "4.0.0",
	"description": "Gulp plugin to validate XML",
	"author": "Jan T. Sott",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/gulp-xml-validator.git"
	},
	"keywords": [
		"gulp",
		"gulpplugin",
		"gulp-plugin",
		"linter",
		"validator",
		"xml",
		"xmldom"
	],
	"files": [
		"dist/",
		"LICENSE",
		"package.json",
		"README.md"
	],
	"engines": {
		"node": ">=20.12"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.12",
		"plugin-error": "^2.0.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@idleberg/configs": "^0.4.6",
		"@types/gulp": "^4.0.18",
		"@types/node": "^24.10.0",
		"@types/vinyl": "^2.0.12",
		"@vitest/coverage-v8": "^5.0.3",
		"concurrently": "^10.0.5",
		"gulp": "^5.0.1",
		"np": "^12.1.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vinyl": "^3.0.1",
		"vitest": "^5.0.3"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "npm run build -- --watch",
		"lint": "concurrently --prefix-colors blue,green,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepack": "npm run build",
		"publish:npm": "np --any-branch",
		"test": "vitest run"
	},
	"packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
